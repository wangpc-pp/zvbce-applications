set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR riscv64)

if(NOT DEFINED ENV{RISCV_CLANG} OR "$ENV{RISCV_CLANG}" STREQUAL "")
  message(FATAL_ERROR
          "RISCV_CLANG must point to a Clang compiler with Zvbce support")
endif()

if(NOT DEFINED ENV{RISCV_SYSROOT} OR "$ENV{RISCV_SYSROOT}" STREQUAL "")
  message(FATAL_ERROR
          "RISCV_SYSROOT must point to a RISC-V Linux sysroot")
endif()

find_program(
  RISCV_CLANG_RESOLVED
  NAMES "$ENV{RISCV_CLANG}"
  NO_CACHE)
if(NOT RISCV_CLANG_RESOLVED)
  message(FATAL_ERROR "RISCV_CLANG is not an executable: $ENV{RISCV_CLANG}")
endif()

if(DEFINED ENV{RISCV_CLANGXX} AND NOT "$ENV{RISCV_CLANGXX}" STREQUAL "")
  find_program(
    RISCV_CLANGXX_RESOLVED
    NAMES "$ENV{RISCV_CLANGXX}"
    NO_CACHE)
else()
  get_filename_component(RISCV_CLANG_DIRECTORY "${RISCV_CLANG_RESOLVED}" DIRECTORY)
  find_program(
    RISCV_CLANGXX_RESOLVED
    NAMES clang++
    HINTS "${RISCV_CLANG_DIRECTORY}"
    NO_DEFAULT_PATH
    NO_CACHE)
endif()

if(NOT RISCV_CLANGXX_RESOLVED)
  message(FATAL_ERROR
          "RISCV_CLANGXX is not executable and clang++ was not found next "
          "to RISCV_CLANG")
endif()

set(CMAKE_C_COMPILER "${RISCV_CLANG_RESOLVED}" CACHE FILEPATH "")
set(CMAKE_CXX_COMPILER "${RISCV_CLANGXX_RESOLVED}" CACHE FILEPATH "")
set(CMAKE_C_COMPILER_TARGET riscv64-unknown-linux-gnu CACHE STRING "")
set(CMAKE_CXX_COMPILER_TARGET riscv64-unknown-linux-gnu CACHE STRING "")
set(CMAKE_SYSROOT "$ENV{RISCV_SYSROOT}" CACHE PATH "")

if(DEFINED ENV{RISCV_GCC_TOOLCHAIN} AND
   NOT "$ENV{RISCV_GCC_TOOLCHAIN}" STREQUAL "")
  set(CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN
      "$ENV{RISCV_GCC_TOOLCHAIN}" CACHE PATH "")
  set(CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN
      "$ENV{RISCV_GCC_TOOLCHAIN}" CACHE PATH "")
endif()

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
